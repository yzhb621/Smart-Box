# Firebase Admin service account (server only)
PROJECT_ID=your-firebase-project-id
CLIENT_EMAIL=your-service-account@your-firebase-project-id.iam.gserviceaccount.com
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"

# Firebase web app configuration (returned to the browser)
API_KEY=your-firebase-web-api-key
AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
STORAGE_BUCKET=your-firebase-storage-bucket
MESSAGING_SENDER_ID=your-sender-id
APP_ID=your-web-app-id
MEASUREMENT_ID=

# Optional EmailJS public key and local server port
PUBLICKEY=
PORT=8080

# EmailJS browser templates
EMAILJS_SERVICE_ID=
EMAILJS_PICKUP_TEMPLATE_ID=
EMAILJS_REGISTRATION_TEMPLATE_ID=
# Server-only optional EmailJS private key. Never return this to the browser.
EMAILJS_PRIVATE_KEY=

# Raspberry Pi controller (export these in the device shell)
SCB_BASE_URL=http://localhost:8080
SCB_POST_CODE=0000
SCB_SERIAL=4
# Existing Firebase ID token, kept in a private file on the Pi. Do not commit it.
SCB_ID_TOKEN_FILE=
SCB_STATE_FILE=
SCB_QR_IMAGE=/tmp/scb-delivery.png
